@page "/"
<PageTitle>Cloud Cost Calculator</PageTitle>
<div class="home-wrap">
    <div class="home-copy">
        <span class="eyebrow">CLOUD COST CALCULATOR</span>
        <h1>Planeje sua infraestrutura.<br /><span>Otimize seus custos.</span></h1>
        <p>Compare o investimento em servidores físicos com a flexibilidade da nuvem e encontre a configuração ideal para sua empresa.</p>
        <div class="home-actions">
            <a class="btn btn-primary" href="/calculadora-nuvem">Calcular custo na nuvem <span>→</span></a>
            <a class="btn btn-ghost" href="/calculadora-fisico">Calcular servidor físico</a>
        </div>
        <div class="home-stats">
            <div><strong>01</strong><span>Configure recursos</span></div>
            <div><strong>02</strong><span>Compare custos</span></div>
            <div><strong>03</strong><span>Tome decisões</span></div>
        </div>
    </div>
    <div class="home-art">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="server-art"><i></i><i></i><i></i><b></b></div><div class="cloud-art">☁</div>
        <div class="art-caption"><span class="live-dot"></span> Infraestrutura sob controle</div>
    </div>
</div>
<style>
.home-wrap{max-width:1400px;min-height:calc(100vh - 56px);display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:40px;padding:30px 4%}
.eyebrow{color:#27caff;letter-spacing:2.4px;font-weight:700;font-size:11px}.home-copy h1{font-size:clamp(38px,4.3vw,65px);line-height:1.08;letter-spacing:-2px;margin:20px 0;color:#f4f8ff}.home-copy h1 span{color:#20c5f6}.home-copy>p{font-size:17px;line-height:1.8;color:#b8cce1;max-width:590px}.home-actions{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0 50px}.home-stats{display:flex;gap:30px;flex-wrap:wrap}.home-stats div{display:flex;flex-direction:column;gap:6px}.home-stats strong{font-size:22px;color:#21c9ff}.home-stats span{font-size:12px;color:#9bb1ca}
.home-art{position:relative;min-height:490px;display:grid;place-items:center;overflow:hidden;background:radial-gradient(ellipse,#06385b 0,transparent 65%)}.orbit{position:absolute;border:1px solid #0c78b966;border-radius:50%;transform:rotate(-25deg)}.orbit-one{width:430px;height:190px}.orbit-two{width:500px;height:260px}.server-art{position:relative;width:180px;height:245px;transform:skewY(-7deg);border:1px solid #128ee8;border-radius:20px;background:linear-gradient(135deg,#0755a0,#031b3b 65%);box-shadow:0 0 55px #087cff55,inset 0 0 30px #0a69c855;padding:30px 18px;z-index:2}.server-art i{display:block;height:48px;border:1px solid #167ee5;border-radius:7px;margin-bottom:12px;background:linear-gradient(90deg,#063b78,#041a39);box-shadow:inset 0 0 20px #078bff22}.server-art i:after{content:"";display:block;width:28px;height:4px;background:#00bfff;margin:22px 0 0 12px;box-shadow:12px 0 #087aff}.server-art b{position:absolute;right:-66px;bottom:4px;font-size:95px;color:#09bfff;text-shadow:0 0 35px #087dff}.art-caption{position:absolute;bottom:30px;border:1px solid #164568;border-radius:30px;padding:10px 18px;color:#b9d8f5;background:#031b2c}.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#17d5ff;margin-right:9px;box-shadow:0 0 10px #17d5ff}
@media(max-width:900px){.home-wrap{grid-template-columns:1fr;padding:25px 2%}.home-art{min-height:330px}.home-copy h1{font-size:42px}}
</style>
