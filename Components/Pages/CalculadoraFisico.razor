@* Temporariamente sem autorização para desenvolvimento do front-end.
   Restaurar antes da entrega. *@
@* @attribute [Authorize] *@
@page "/calculadora-fisico"
@using Microsoft.AspNetCore.Authorization
<PageTitle>Calculadora Servidor Físico</PageTitle>
<div class="calc-page">
    <header class="calc-header"><div><h1 class="page-heading">Custos do servidor físico</h1><p class="page-subtitle">Configure o equipamento e estime investimento inicial e custos operacionais.</p></div><span class="status-pill"><i></i> Simulação</span></header>
    <div class="physical-grid">
        <section class="panel physical-config">
            <div class="section-head"><span class="step-number">1</span><div><h2>Configuração do servidor</h2><p>Selecione os componentes e itens necessários.</p></div></div>
            <div class="field"><label>Modelo do servidor</label><select class="control" @bind="model"><option>Servidor Tower</option><option>Servidor Rack</option><option>Servidor Blade</option></select></div>
            <div class="field"><label>Processador (CPU)</label><select class="control" @bind="cpu"><option value="4">Xeon Silver (4 núcleos)</option><option value="8">Xeon Silver (8 núcleos)</option><option value="16">Xeon Gold (16 núcleos)</option><option value="32">Xeon Gold (32 núcleos)</option></select></div>
            <div class="field"><label>Memória RAM</label><select class="control" @bind="ram"><option value="16">16 GB</option><option value="32">32 GB</option><option value="64">64 GB</option><option value="128">128 GB</option></select></div>
            <div class="field"><label>Armazenamento</label><select class="control" @bind="disks"><option value="1">1 × 960 GB SSD</option><option value="2">2 × 960 GB SSD</option><option value="4">4 × 1 TB NVMe</option><option value="8">8 × 2 TB HDD</option></select></div>
            <div class="field"><label>RAID</label><select class="control" @bind="raid"><option>RAID 1</option><option>RAID 0</option><option>RAID 5</option><option>RAID 10</option><option>Sem RAID</option></select></div>
            <div class="field"><label>Fonte de alimentação</label><select class="control" @bind="psu"><option>Redundante</option><option>Simples</option></select></div>
            <div class="field"><label>Nobreak (UPS)</label><select class="control" @bind="ups"><option>Sim (3 kVA)</option><option>Sim (5 kVA)</option><option>Não</option></select></div>
            <div class="field"><label>Licenças de sistema</label><select class="control" @bind="license"><option>Windows Server</option><option>Linux</option></select></div>
            <div class="field"><label>Instalação e configuração</label><select class="control" @bind="install"><option>Sim</option><option>Não</option></select></div>
            <div class="field"><label>Suporte e manutenção</label><select class="control" @bind="support"><option>Contrato anual</option><option>Sem contrato</option></select></div>
        </section>
        <aside class="panel physical-summary">
            <h2>Resumo</h2><p class="muted">Custos estimados (valores ilustrativos)</p>
            <h3>Investimento inicial</h3>
            <div class="cost-row"><span>Servidor e componentes</span><strong>@Money(serverCost)</strong></div>
            <div class="cost-row"><span>Licenças de sistema</span><strong>@Money(license == "Windows Server" ? 5000 : 0)</strong></div>
            <div class="cost-row"><span>Nobreak (UPS)</span><strong>@Money(ups == "Não" ? 0 : ups.Contains("5 kVA") ? 4500 : 3000)</strong></div>
            <div class="cost-row"><span>Instalação e configuração</span><strong>@Money(install == "Sim" ? 1500 : 0)</strong></div>
            <div class="total-row"><span>Total inicial</span><strong>@Money(initial)</strong></div>
            <h3>Custos mensais</h3>
            <div class="cost-row"><span>Energia elétrica</span><strong>@Money(energy)</strong></div>
            <div class="cost-row"><span>Conectividade (Internet)</span><strong>R$ 300,00</strong></div>
            <div class="cost-row"><span>Manutenção / Suporte</span><strong>@Money(support == "Contrato anual" ? 400 : 0)</strong></div>
            <div class="cost-row"><span>Outros custos</span><strong>R$ 250,00</strong></div>
            <div class="total-row"><span>Total mensal</span><strong>@Money(monthly)</strong></div>
            <div class="total-box"><span>Custo total estimado em 5 anos</span><strong>@Money(initial + monthly * 60)</strong></div>
            <button class="btn btn-primary full" @onclick="Reset">Restaurar configuração <span>↺</span></button>
            <p class="disclaimer">ⓘ Valores fictícios para demonstração. Ajuste os preços para refletir sua realidade.</p>
        </aside>
    </div>
</div>
@code {
    private string model = "Servidor Tower", raid = "RAID 1", psu = "Redundante", ups = "Sim (3 kVA)", license = "Windows Server", install = "Sim", support = "Contrato anual";
    private int cpu = 8, ram = 32, disks = 2;
    private decimal serverCost => 9000 + cpu * 450 + ram * 45 + disks * 1200 + (model == "Servidor Rack" ? 3500 : model == "Servidor Blade" ? 6500 : 0) + (psu == "Redundante" ? 1800 : 0) + (raid == "RAID 10" ? 900 : raid == "RAID 5" ? 500 : 0);
    private decimal initial => serverCost + (license == "Windows Server" ? 5000 : 0) + (ups == "Não" ? 0 : ups.Contains("5 kVA") ? 4500 : 3000) + (install == "Sim" ? 1500 : 0);
    private decimal energy => (cpu * 18 + ram * 2 + disks * 15) * 0.72m;
    private decimal monthly => energy + 300 + (support == "Contrato anual" ? 400 : 0) + 250;
    private static string Money(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    private void Reset() { model = "Servidor Tower"; cpu = 8; ram = 32; disks = 2; raid = "RAID 1"; psu = "Redundante"; ups = "Sim (3 kVA)"; license = "Windows Server"; install = "Sim"; support = "Contrato anual"; }
}
<style>
.physical-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(330px,.95fr);gap:20px;align-items:start}.physical-config,.physical-summary{padding:24px}.physical-config .section-head{margin-bottom:24px}.physical-config .field{display:grid;grid-template-columns:minmax(130px,.75fr) minmax(180px,1.25fr);align-items:center;gap:14px;margin-bottom:13px}.physical-config .field label{color:#c6d8ec;font-size:12px}.physical-config .control{height:38px;font-size:12px}.physical-summary h2{font-size:19px;margin:0 0 5px}.physical-summary h3{font-size:13px;margin:24px 0 9px;color:#e4f1ff}.cost-row{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #17364c;font-size:11px}.cost-row span{color:#a9bfd5}.cost-row strong{font-weight:500;white-space:nowrap}.total-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 0;border-bottom:1px solid #1b405b;font-size:13px}.total-row strong{font-size:20px;color:#25d5f8;white-space:nowrap}.total-box{margin:17px 0;border:1px solid #1682ad;border-radius:12px;padding:15px;background:#05253b}.total-box span{display:block;font-size:11px;color:#b0c7dd}.total-box strong{display:block;font-size:25px;color:#20d4fa;margin-top:5px}.physical-summary .disclaimer{margin-top:12px}
@@media(max-width:1050px){.physical-grid{grid-template-columns:1fr}}@@media(max-width:600px){.physical-config,.physical-summary{padding:16px}.physical-config .field{grid-template-columns:1fr;gap:6px}}
</style>
