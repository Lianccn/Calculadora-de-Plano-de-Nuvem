@* Temporariamente sem autorização para desenvolvimento do front-end.
   Restaurar antes da entrega. *@
@* @attribute [Authorize] *@
@using Microsoft.EntityFrameworkCore
@using Calculadora_de_Plano_de_Nuvem.Data
@using Calculadora_de_Plano_de_Nuvem.Models
@using Calculadora_de_Plano_de_Nuvem.Services
@using Microsoft.AspNetCore.Authorization

@inject InfraAtualService InfraAtualService
@inject RecomendacaoInfraFisicaService RecomendacaoService
@inject CalculadoraContext Context

@page "/calculadora-fisico"
@rendermode InteractiveServer
<PageTitle>Calculadora Servidor Físico</PageTitle>
<div class="calc-page">
    <header class="calc-header"><div><h1 class="page-heading">Custos do servidor físico</h1><p class="page-subtitle">Configure o equipamento e estime investimento inicial e custos operacionais.</p></div><span class="status-pill"><i></i> Simulação</span></header>
    <div class="physical-grid">
        <section class="panel physical-config">
            <div class="section-head"><span class="step-number">1</span><div><h2>Configuração do servidor</h2><p>Selecione os componentes e itens necessários.</p></div></div>
            <div class="field"><label>Modelo do servidor</label><select class="control" @bind="model"><option>Servidor Tower</option><option>Servidor Rack</option><option>Servidor Blade</option></select></div>
            <div class="field">
                <label>Processador (CPU)</label>

                <select class="control" @bind="processadorIdSelecionado"
                        @bind:after="AtualizarProcessador">
                    @foreach (var processador in processadores)
                    {
                        <option value="@processador.Id">
                            @processador.Nome - @processador.Nucleos núcleos /
                            @processador.Threads threads -
                            @Money(processador.Preco)
                        </option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Memória RAM</label>

                <select class="control" @bind="memoriaRamIdSelecionada"
                        @bind:after="AtualizarMemoriaRam">

                    @foreach (var memoria in memoriasRam)
                    {
                        <option value="@memoria.Id">
                            @memoria.Fabricante @memoria.Modelo -
                            @memoria.CapacidadeGb GB -
                            @Money(memoria.Preco)
                        </option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Armazenamento</label>

                <select class="control"
                        @bind="discoIdSelecionado"
                        @bind:after="AtualizarDisco">

                    @foreach (var disco in discosDisponiveis)
                    {
                        <option value="@disco.Id">
                            @disco.Fabricante @disco.Modelo -
                            @disco.CapacidadeGb GB @disco.Tipo -
                            @Money(disco.Preco)
                        </option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Quantidade de discos</label>

                <select class="control" @bind="disks">
                    <option value="1">1 disco</option>
                    <option value="2">2 discos</option>
                    <option value="4">4 discos</option>
                    <option value="8">8 discos</option>
                </select>
            </div>
            <div class="field"><label>RAID</label><select class="control" @bind="raid"><option>RAID 1</option><option>RAID 0</option><option>RAID 5</option><option>RAID 10</option><option>Sem RAID</option></select></div>
            <div class="field"><label>Fonte de alimentação</label><select class="control" @bind="psu"><option>Redundante</option><option>Simples</option></select></div>
            <div class="field"><label>Nobreak (UPS)</label><select class="control" @bind="ups"><option>Sim (3 kVA)</option><option>Sim (5 kVA)</option><option>Não</option></select></div>
            <div class="field"><label>Licenças de sistema</label><select class="control" @bind="license"><option>Windows Server</option><option>Linux</option></select></div>
            <div class="field"><label>Instalação e configuração</label><select class="control" @bind="install"><option>Sim</option><option>Não</option></select></div>
            <div class="field"><label>Suporte e manutenção</label><select class="control" @bind="support"><option>Contrato anual</option><option>Sem contrato</option></select></div>
        </section>
        <aside class="panel physical-summary">
            <h2>Resumo</h2><p class="muted"><strong>Custos estimados para operação 24 horas por dia - empresa de médio porte.</strong></p>
            <h3>Investimento inicial</h3>
            <div class="cost-row"><span>Servidor e componentes</span><strong>@Money(serverCost)</strong></div>
            <div class="cost-row"><span>Licenças de sistema</span><strong>@Money(license == "Windows Server" ? 5000 : 0)</strong></div>
            <div class="cost-row"><span>Nobreak (UPS)</span><strong>@Money(ups == "Não" ? 0 : ups.Contains("5 kVA") ? 4500 : 3000)</strong></div>
            <div class="cost-row"><span>Instalação e configuração</span><strong>@Money(install == "Sim" ? 1500 : 0)</strong></div>
            <div class="total-row"><span>Total inicial</span><strong>@Money(initial)</strong></div>
            <h3>Custos mensais</h3>
            <div class="cost-row"><span>Energia elétrica</span><strong>@Money(energy)</strong></div>
            <div class="cost-row"><span>Conectividade (Internet)</span><strong>R$ 300,00</strong></div>
            <div class="cost-row"><span>Manutenção / Suporte</span><strong>@Money(support == "Contrato anual" ? 400 : 0)</strong></div>
            <div class="cost-row"><span>Outros custos</span><strong>R$ 250,00</strong></div>
            <div class="total-row"><span>Total mensal</span><strong>@Money(monthly)</strong></div>
            <div class="total-box">
                <span>Composição do custo em 5 anos</span>

                <div class="cost-row">
                    <span>Investimento inicial</span>
                    <strong>@Money(initial)</strong>
                </div>

                <div class="cost-row">
                    <span>Custos mensais acumulados (60 meses)</span>
                    <strong>@Money(monthly * 60)</strong>
                </div>

                <div class="total-row">
                    <span>Custo total estimado em 5 anos</span>
                    <strong>@Money(initial + monthly * 60)</strong>
                </div>
            </div>
            <button type="button" class="btn btn-primary full" @onclick="Reset"> Restaurar configuração <span>↺</span></button>
            <p class="disclaimer">ⓘ Valores fictícios para demonstração. Ajuste os preços para refletir sua realidade.</p>
        </aside>
    </div>
</div>
@code {
    private string model = "Servidor Tower";
    private string raid = "RAID 1";
    private string psu = "Redundante";
    private string ups = "Sim (3 kVA)";
    private string license = "Windows Server";
    private string install = "Sim";
    private string support = "Contrato anual";

    private int cpu = 8;
    private int ram = 32;
    private int disks = 2;

    // Investimento inicial
    private const decimal CustoChassi = 3000m;
    private const decimal CustoFonteRedundante = 1200m;
    private const decimal CustoFonteSimples = 600m;
    private const decimal LicencaWindows = 5000m;
    private const decimal Nobreak3Kva = 3000m;
    private const decimal Nobreak5Kva = 4500m;
    private const decimal CustoInstalacao = 1500m;

    // Custos mensais
    private const decimal CustoInternet = 300m;
    private const decimal CustoManutencao = 250m;
    private const decimal CustoSuporte = 400m;
    private const decimal OutrosCustos = 100m;

    // Energia
    private const decimal PotenciaBase = 150m;
    private const decimal WattsPorNucleo = 8m;
    private const decimal WattsPorGbRam = 0.4m;
    private const decimal WattsPorSsd = 3m;
    private const decimal WattsPorHd = 8m;
    private const decimal Pue = 1.5m;
    private const decimal TarifaKwh = 1.00m;
    private const int HorasMensais = 720;

    private decimal serverCost => CustoChassi + precoProcessador + custoTotalMemoria + custoTotalDiscos + (psu == "Redundante" ? CustoFonteRedundante : CustoFonteSimples) 
    + (raid == "RAID 10" ? 900m : raid == "RAID 5" ? 500m : 0m);
    private decimal initial => serverCost + (license == "Windows Server" ? LicencaWindows : 0m) + (ups == "Não" ? 0m : ups.Contains("5 kVA") ? Nobreak5Kva : Nobreak3Kva) 
    + (install == "Sim" ? CustoInstalacao : 0m);
    private Disco? discoAtual => discosDisponiveis.FirstOrDefault( d => d.Id == discoIdSelecionado);
    private decimal consumoDiscos => disks * (discoAtual?.Tipo == TipoDisco.Hd ? WattsPorHd : WattsPorSsd);
    private decimal potenciaServidor => PotenciaBase + cpu * WattsPorNucleo + ram * WattsPorGbRam + consumoDiscos;
    private decimal energy => (potenciaServidor / 1000m) * HorasMensais * Pue * TarifaKwh;
    private decimal monthly => energy + CustoInternet + CustoManutencao + (support == "Contrato anual" ? CustoSuporte : 0m) + OutrosCustos;
    private static string Money(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    private void Reset()
    {
        Console.WriteLine("Método Reset Executado!");
        model = "Servidor Tower";
        raid = "RAID 1";
        psu = "Redundante";
        ups = "Sim (3 kVA)";
        license = "Windows Server";
        install = "Sim";
        support = "Contrato anual";

        if (recomendacao == null)
            return;

        processadorIdSelecionado = recomendacao.ProcessadorId;
        AtualizarProcessador();

        memoriaRamIdSelecionada = recomendacao.MemoriaRamId;
        AtualizarMemoriaRam();

        var discoRecomendado = recomendacao.Armazenamentos.FirstOrDefault();

        if (discoRecomendado != null)
        {
            discoIdSelecionado = discoRecomendado.DiscoId;
            disks = discoRecomendado.QuantidadeDiscos;
        }

        StateHasChanged();
    }

    private string processadorSelecionado = "";
    private string discoSelecionado = "";
    private List<Processador> processadores = new();
    private int processadorIdSelecionado;
    private decimal precoProcessador => processadores.FirstOrDefault(p => p.Id == processadorIdSelecionado)?.Preco ?? 0;
    private List<MemoriaRam> memoriasRam = new();
    private int memoriaRamIdSelecionada;
    private decimal precoMemoriaRam => memoriasRam.FirstOrDefault(m => m.Id == memoriaRamIdSelecionada)?.Preco ?? 0;
    private decimal custoTotalMemoria => precoMemoriaRam * (recomendacao?.QuantidadeModulos ?? 0);
    private List<Disco> discosDisponiveis = new();
    private int discoIdSelecionado;
    private decimal precoDisco => discosDisponiveis.FirstOrDefault(d => d.Id == discoIdSelecionado)?.Preco ?? 0;
    private decimal custoTotalDiscos => precoDisco * disks;

    [SupplyParameterFromQuery]
    public int SimulacaoId { get; set; }

    private InfraAtual? infraAtual;

    private InfraFisico? recomendacao;

    protected override async Task OnInitializedAsync()
    {
        infraAtual = await InfraAtualService.BuscarPorSimulacaoAsync(SimulacaoId);

        if (infraAtual == null)
        {
            return;
        }

        recomendacao = await RecomendacaoService.GerarInfraFisicoAsync(infraAtual.Id);

        if (recomendacao == null)
        {
            return;
        }

        processadorSelecionado = recomendacao.Processador.Nome;
        discoSelecionado = string.Join(", ",recomendacao.Armazenamentos.Select(a => $"{a.QuantidadeDiscos}x {a.Disco.Fabricante} {a.Disco.Modelo} - " + 
        $"{a.Disco.CapacidadeGb} GB {a.Disco.Tipo}"));
        processadores = await Context.Processadores
            .Where(p => p.Preco > 0)
            .OrderBy(p => p.Preco)
            .ToListAsync();

        processadorIdSelecionado = recomendacao.ProcessadorId;

        memoriasRam = await Context.MemoriasRam
            .Where(m => m.Preco > 0 && m.Tipo == TipoMemoria.DDR4)
            .OrderBy(m => m.CapacidadeGb)
            .ThenBy(m => m.Preco)
            .ToListAsync();

        memoriaRamIdSelecionada = recomendacao.MemoriaRamId;
        
        discosDisponiveis = await Context.Discos
            .Where(d => d.Preco > 0)
            .OrderBy(d => d.CapacidadeGb)
            .ThenBy(d => d.Preco)
            .ToListAsync();

        var discoRecomendado = recomendacao.Armazenamentos.FirstOrDefault();

        if (discoRecomendado != null)
        {
            discoIdSelecionado = discoRecomendado.DiscoId;
        }

        // Atualiza os valores utilizados nos cálculos
        cpu = recomendacao.Processador.Nucleos;

        ram = recomendacao.MemoriaRam.CapacidadeGb
              * recomendacao.QuantidadeModulos;

        disks = recomendacao.Armazenamentos
            .Sum(a => a.QuantidadeDiscos);
    }

    private void AtualizarProcessador()
    {
        var processador = processadores
            .FirstOrDefault(p => p.Id == processadorIdSelecionado);

        if (processador == null)
            return;

        cpu = processador.Nucleos;
    }

    private void AtualizarMemoriaRam()
    {
        var memoria = memoriasRam
            .FirstOrDefault(m => m.Id == memoriaRamIdSelecionada);

        if (memoria == null)
            return;

        ram = memoria.CapacidadeGb * recomendacao!.QuantidadeModulos;
    }

    private void AtualizarDisco()
    {
        var disco = discosDisponiveis.FirstOrDefault(d => d.Id == discoIdSelecionado);

        if (disco == null)
            return;
    }

}

<style>

    .physical-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(330px, .95fr);
        gap: 20px;
        align-items: start;
    }

    .physical-config,
    .physical-summary {
        padding: 24px;
    }

        .physical-config .section-head {
            margin-bottom: 24px;
        }

        .physical-config .field {
            display: grid;
            grid-template-columns: minmax(130px, .75fr) minmax(180px, 1.25fr);
            align-items: center;
            gap: 14px;
            margin-bottom: 13px;
        }

            .physical-config .field label {
                color: #c6d8ec;
                font-size: 14px;
            }

        .physical-config .control {
            height: 42px;
            font-size: 14px;
        }

        .physical-summary h2 {
            font-size: 21px;
            margin: 0 0 6px;
        }

        .physical-summary h3 {
            font-size: 16px;
            margin: 24px 0 10px;
            color: #e4f1ff;
        }

        .physical-summary > p.muted {
            font-size: 14px;
        }

    .cost-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #17364c;
        font-size: 14px;
    }

        .cost-row span {
            color: #a9bfd5;
        }

        .cost-row strong {
            font-size: 14px;
            font-weight: 500;
            white-space: nowrap;
        }

    .total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 15px 0;
        border-bottom: 1px solid #1b405b;
        font-size: 15px;
    }

        .total-row strong {
            font-size: 18px;
            color: #25d5f8;
            white-space: nowrap;
        }

    .total-box {
        margin: 17px 0;
        border: 1px solid #1682ad;
        border-radius: 12px;
        padding: 16px;
        background: #05253b;
    }

        .total-box span {
            display: block;
            font-size: 14px;
            color: #b0c7dd;
        }

        .total-box strong {
            display: block;
            font-size: 21px;
            color: #20d4fa;
            margin-top: 8px;
        }

    .physical-summary .disclaimer {
        margin-top: 12px;
        font-size: 13px;
    }

    @@media (max-width: 1050px) {
        .physical-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .physical-config,
        .physical-summary {
            padding: 16px;
        }

            .physical-config .field {
                grid-template-columns: 1fr;
                gap: 6px;
            }

        .cost-row,
        .total-row {
            gap: 8px;
        }
    }

</style>
