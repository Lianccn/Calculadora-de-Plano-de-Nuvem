@page "/login"
@layout MainLayout
<PageTitle>Entrar - Cloud Cost Calculator</PageTitle>
<div class="auth-page">
    <section class="panel login-card">
        <a class="auth-brand" href="/"><span>☁</span><b>Cloud Cost<br />Calculator</b></a>
        <h1>Bem-vindo de volta</h1><p class="auth-subtitle">Entre para continuar sua simulação de custos.</p>
        <EditForm Model="form" OnValidSubmit="Submit">
            <div class="field"><label>E-mail</label><input class="control" type="email" @bind="form.Email" placeholder="seu@email.com" required /></div>
            <div class="field"><label>Senha</label><input class="control" type="password" @bind="form.Senha" placeholder="Sua senha" required /></div>
            <div class="auth-options"><label><input type="checkbox" @bind="remember" /> Lembrar de mim</label><a href="/cadastro">Criar conta</a></div>
            <button class="btn btn-primary full" type="submit">Entrar <span>→</span></button>
        </EditForm>
        @if (!string.IsNullOrWhiteSpace(message)) { <p class="form-message">@message</p> }
        <div class="auth-divider"><span>ou</span></div>
        <a class="btn btn-ghost full" href="/cadastro">＋ Criar conta</a>
        <p class="auth-foot">Projeto acadêmico · Cloud Cost Calculator</p>
    </section>
    <aside class="auth-aside"><span class="eyebrow">INFRAESTRUTURA INTELIGENTE</span><h2>Sua infraestrutura,<br />sem mistério.</h2><p>Simule, compare e encontre a melhor solução para o seu negócio.</p><div class="auth-illustration"><div class="server-art"><i></i><i></i><i></i><b></b></div><div class="cloud-art">☁</div></div></aside>
</div>
@code {
    private LoginForm form = new();
    private bool remember;
    private string message = "";
    private void Submit() => message = "Tela demonstrativa: a autenticação ainda precisa ser conectada ao backend.";
    private sealed class LoginForm { public string Email { get; set; } = ""; public string Senha { get; set; } = ""; }
}
<style>
.auth-page{max-width:1200px;min-height:calc(100vh - 56px);display:grid;grid-template-columns:minmax(360px,1fr) minmax(260px,.8fr);gap:50px;align-items:center;padding:20px 5%}.login-card{padding:32px;max-width:480px;width:100%;margin:auto}.auth-brand{display:flex;justify-content:center;align-items:center;gap:10px;text-decoration:none;margin-bottom:25px}.auth-brand span{font-size:52px;color:#17c8ff}.auth-brand b{font-size:21px;line-height:1.05}.login-card h1{text-align:center;font-size:25px;margin:0 0 6px}.auth-subtitle{text-align:center;color:#a9bfd7;font-size:12px;margin:0 0 26px}.login-card .field{margin-bottom:16px}.auth-options{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#b7cbe0;margin:14px 0 20px}.auth-options label{display:flex;align-items:center;gap:6px}.auth-options a{color:#25c8f8}.auth-divider{display:flex;align-items:center;gap:15px;margin:18px 0;color:#9bb0c7;font-size:11px}.auth-divider:before,.auth-divider:after{content:"";height:1px;background:#24445c;flex:1}.auth-foot{text-align:center;color:#9bb0c7;font-size:10px;margin:24px 0 0}.auth-aside{max-width:390px}.auth-aside h2{font-size:30px;color:#36caff;line-height:1.15}.auth-aside p{color:#b4c9df;line-height:1.7}.auth-illustration{height:260px;position:relative;display:grid;place-items:center;background:radial-gradient(ellipse,#06345a,transparent 70%)}.auth-illustration .server-art{transform:scale(.72) skewY(-7deg)}.cloud-art{position:absolute;font-size:90px;color:#10bfff;text-shadow:0 0 35px #087dff;right:12%;bottom:15px}.form-message{color:#68dbff;font-size:12px;line-height:1.5}
@media(max-width:850px){.auth-page{grid-template-columns:1fr;padding:20px 0}.auth-aside{display:none}.login-card{max-width:520px}} 
</style>
